# Base44 dev image — installs Node deps only; source is bind-mounted at runtime.
FROM node:22

# Enable Corepack for the pinned Yarn version
RUN corepack enable

WORKDIR /app/frontend

# Install deps from lockfile (node_modules preserved via anonymous volume at runtime)
COPY package.json yarn.lock .npmrc ./
COPY scripts ./scripts
RUN yarn install --frozen-lockfile

# Source is bind-mounted in compose; nothing else to COPY.
EXPOSE 3000
CMD ["npx", "expo", "start", "--web", "--port", "3000", "--host", "lan"]
